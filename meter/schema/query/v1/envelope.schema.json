{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/automagik-dev/automagik/meter/schema/query/v1/envelope.schema.json",
  "title": "usagemeter query, contract version 1",
  "description": "What `usagemeter query --json` prints on stdout, for every exit code it defines. RFC 0018.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract", "contract_version", "capability", "meter_version", "status", "error",
    "generated_at", "as_of", "machine", "store", "ingestion", "window", "sources", "pricing",
    "query", "rows", "page"
  ],
  "properties": {
    "contract": { "const": "usagemeter.query" },
    "contract_version": { "const": 1 },
    "capability": { "const": "meter.usage@1" },
    "meter_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+([-+][0-9A-Za-z.-]+)?$" },
    "status": {
      "enum": [
        "ok", "usage", "error", "absent_store", "locked", "newer_schema", "outdated_store",
        "unsupported_contract"
      ]
    },
    "error": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message"],
          "properties": {
            "code": { "type": "string", "minLength": 1 },
            "message": { "type": "string", "minLength": 1 },
            "retry_after_s": { "type": "integer", "minimum": 1 },
            "store_schema_version": { "type": "integer", "minimum": 0 },
            "supported_schema_version": { "type": "integer", "minimum": 1 },
            "supported_contracts": { "type": "array", "items": { "type": "integer", "minimum": 1 } }
          }
        }
      ]
    },
    "generated_at": { "$ref": "#/$defs/time" },
    "as_of": { "$ref": "#/$defs/timeOrNull" },
    "machine": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "scope"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "scope": { "const": "local" }
          }
        }
      ]
    },
    "store": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["schema_version", "location"],
          "properties": {
            "schema_version": { "type": "integer", "minimum": 0 },
            "location": { "enum": ["current", "legacy", "override"] }
          }
        }
      ]
    },
    "ingestion": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "watermark", "counted_from", "evidence_from", "complete", "backlog", "stale",
            "stale_after_s"
          ],
          "properties": {
            "watermark": { "$ref": "#/$defs/timeOrNull" },
            "counted_from": { "$ref": "#/$defs/time" },
            "evidence_from": { "$ref": "#/$defs/timeOrNull" },
            "complete": { "type": "boolean" },
            "backlog": {
              "type": "object",
              "additionalProperties": false,
              "required": ["bytes", "files"],
              "properties": {
                "bytes": { "type": "integer", "minimum": 0 },
                "files": { "type": "integer", "minimum": 0 }
              }
            },
            "stale": { "type": "boolean" },
            "stale_after_s": { "type": "integer", "minimum": 60 }
          }
        }
      ]
    },
    "window": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "requested_start", "start", "end", "clipped"],
          "properties": {
            "name": { "enum": ["d1", "d7", "d30"] },
            "requested_start": { "$ref": "#/$defs/time" },
            "start": { "$ref": "#/$defs/time" },
            "end": { "$ref": "#/$defs/time" },
            "clipped": { "type": "boolean" }
          }
        }
      ]
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["harness", "status", "reason", "last_success", "stale"],
        "properties": {
          "harness": { "type": "string", "minLength": 1 },
          "status": { "enum": ["ok", "degraded", "unsupported", "absent"] },
          "reason": { "type": ["string", "null"] },
          "last_success": { "$ref": "#/$defs/timeOrNull" },
          "stale": { "type": "boolean" }
        }
      }
    },
    "pricing": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["table", "reported_wins", "long_prompt_tiers"],
          "properties": {
            "table": {
              "type": "object",
              "additionalProperties": false,
              "required": ["origin", "date", "source", "label", "sha256"],
              "properties": {
                "origin": { "enum": ["bundled", "override", "fetched"] },
                "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
                "source": { "type": "string", "minLength": 1 },
                "label": { "type": "string" },
                "sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" }
              }
            },
            "reported_wins": { "const": true },
            "long_prompt_tiers": { "type": "boolean" }
          }
        }
      ]
    },
    "query": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["repo", "branches", "window", "page"],
          "properties": {
            "repo": { "$ref": "#/$defs/repo" },
            "branches": {
              "type": "array",
              "minItems": 1,
              "maxItems": 500,
              "items": { "$ref": "#/$defs/branch" }
            },
            "window": { "enum": ["d1", "d7", "d30"] },
            "page": { "type": ["string", "null"] }
          }
        }
      ]
    },
    "rows": { "type": "array", "items": { "$ref": "#/$defs/row" } },
    "page": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["next", "returned"],
          "properties": {
            "next": { "type": ["string", "null"] },
            "returned": { "type": "integer", "minimum": 0 }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "ok" } } },
      "then": {
        "properties": {
          "error": { "type": "null" },
          "machine": { "type": "object" },
          "store": { "type": "object" },
          "ingestion": { "type": "object" },
          "window": { "type": "object" },
          "pricing": { "type": "object" },
          "query": { "type": "object" },
          "page": { "type": "object" }
        }
      },
      "else": {
        "properties": {
          "error": { "type": "object" },
          "rows": { "type": "array", "maxItems": 0 },
          "page": { "type": "null" }
        }
      }
    },
    {
      "if": { "properties": { "status": { "const": "absent_store" } } },
      "then": {
        "properties": {
          "machine": { "type": "null" },
          "store": { "type": "null" },
          "ingestion": { "type": "null" },
          "as_of": { "type": "null" }
        }
      }
    },
    {
      "if": { "properties": { "status": { "enum": ["newer_schema", "outdated_store"] } } },
      "then": {
        "properties": {
          "store": { "type": "object" },
          "error": { "type": "object", "required": ["code", "message", "store_schema_version", "supported_schema_version"] }
        }
      }
    },
    {
      "if": { "properties": { "status": { "const": "locked" } } },
      "then": { "properties": { "error": { "type": "object", "required": ["code", "message", "retry_after_s"] } } }
    },
    {
      "if": { "properties": { "status": { "const": "unsupported_contract" } } },
      "then": { "properties": { "error": { "type": "object", "required": ["code", "message", "supported_contracts"] } } }
    }
  ],
  "$defs": {
    "time": { "type": "string", "format": "date-time", "pattern": "Z$" },
    "timeOrNull": {
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/time" }]
    },
    "repo": {
      "description": "host/owner/repo as the meter normalizes a remote: credential-free, host lower-cased, no port, no .git, path case kept.",
      "type": "string",
      "pattern": "^[a-z0-9.-]+(/[^/\\s]+)+$",
      "maxLength": 512
    },
    "branch": { "type": "string", "minLength": 1, "maxLength": 255, "pattern": "^\\S+$" },
    "tokens": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input", "cache_read", "cache_write_5m", "cache_write_1h", "output", "reasoning",
        "unsplit", "total"
      ],
      "properties": {
        "input": { "type": "integer", "minimum": 0 },
        "cache_read": { "type": "integer", "minimum": 0 },
        "cache_write_5m": { "type": "integer", "minimum": 0 },
        "cache_write_1h": { "type": "integer", "minimum": 0 },
        "output": { "type": "integer", "minimum": 0 },
        "reasoning": { "type": "integer", "minimum": 0, "description": "Inside output, never added to total." },
        "unsplit": { "type": "integer", "minimum": 0, "description": "Known only as a total (precision total_only)." },
        "total": { "type": "integer", "minimum": 0, "description": "input + cache_read + cache_write_5m + cache_write_1h + output + unsplit." }
      }
    },
    "cost": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state", "usd", "usd_reported", "usd_estimated", "tokens_priced", "tokens_reported",
        "tokens_unpriced", "unpriced_models"
      ],
      "properties": {
        "state": { "enum": ["priced", "partial", "unpriced", "zero"] },
        "usd": { "type": ["number", "null"], "minimum": 0 },
        "usd_reported": { "type": ["number", "null"], "minimum": 0 },
        "usd_estimated": { "type": ["number", "null"], "minimum": 0 },
        "tokens_priced": { "type": "integer", "minimum": 0 },
        "tokens_reported": { "type": "integer", "minimum": 0 },
        "tokens_unpriced": { "type": "integer", "minimum": 0 },
        "unpriced_models": { "type": "array", "items": { "type": "string" } }
      },
      "allOf": [
        {
          "if": { "properties": { "state": { "const": "unpriced" } } },
          "then": { "properties": { "usd": { "type": "null" }, "tokens_priced": { "const": 0 }, "tokens_reported": { "const": 0 } } }
        },
        {
          "if": { "properties": { "state": { "enum": ["priced", "partial", "zero"] } } },
          "then": { "properties": { "usd": { "type": "number" }, "usd_reported": { "type": "number" }, "usd_estimated": { "type": "number" } } }
        },
        {
          "if": { "properties": { "state": { "const": "priced" } } },
          "then": { "properties": { "tokens_unpriced": { "const": 0 } } }
        },
        {
          "if": { "properties": { "state": { "const": "partial" } } },
          "then": { "properties": { "tokens_unpriced": { "type": "integer", "minimum": 1 } } }
        },
        {
          "if": { "properties": { "state": { "const": "zero" } } },
          "then": {
            "properties": {
              "usd": { "const": 0 }, "tokens_priced": { "const": 0 }, "tokens_reported": { "const": 0 },
              "tokens_unpriced": { "const": 0 }
            }
          }
        }
      ]
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "branch", "requested", "state", "reason", "tokens", "cost", "token_precision",
        "attribution", "activity", "incomplete_sources"
      ],
      "properties": {
        "branch": { "$ref": "#/$defs/branch" },
        "requested": { "type": "integer", "minimum": 1, "description": "How many times the call named this branch; above 1, cards share it." },
        "state": { "enum": ["measured", "zero", "missing", "stale", "unsupported"] },
        "reason": {
          "enum": [
            null, "repo_not_seen", "window_before_counted_from", "backlog", "source_incomplete",
            "ingestion_stale", "source_unsupported"
          ]
        },
        "tokens": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/tokens" }] },
        "cost": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/cost" }] },
        "token_precision": { "enum": [null, "exact", "mixed", "total_only"] },
        "attribution": {
          "type": "object",
          "additionalProperties": false,
          "required": ["precision", "exclusive", "shared"],
          "properties": {
            "precision": { "enum": ["branch_window"], "description": "v1 rows are (repo, branch) totals over the window: never task cost." },
            "exclusive": { "const": false },
            "shared": { "type": "boolean" }
          }
        },
        "activity": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["first_hour", "last_hour", "hours", "harnesses"],
              "properties": {
                "first_hour": { "$ref": "#/$defs/timeOrNull" },
                "last_hour": { "$ref": "#/$defs/timeOrNull" },
                "hours": { "type": "integer", "minimum": 0, "description": "Distinct hours with usage, not elapsed time." },
                "harnesses": { "type": "array", "items": { "type": "string" } }
              }
            }
          ]
        },
        "incomplete_sources": { "type": "array", "items": { "type": "string" } }
      },
      "allOf": [
        {
          "if": { "properties": { "state": { "enum": ["measured", "zero"] } } },
          "then": {
            "properties": {
              "reason": { "const": null }, "tokens": { "type": "object" }, "cost": { "type": "object" },
              "activity": { "type": "object" }
            }
          }
        },
        {
          "if": { "properties": { "state": { "const": "measured" } } },
          "then": {
            "properties": {
              "tokens": { "type": "object", "properties": { "total": { "type": "integer", "minimum": 1 } } },
              "cost": { "type": "object", "properties": { "state": { "enum": ["priced", "partial", "unpriced"] } } },
              "token_precision": { "enum": ["exact", "mixed", "total_only"] }
            }
          }
        },
        {
          "if": { "properties": { "state": { "const": "zero" } } },
          "then": {
            "properties": {
              "tokens": { "type": "object", "properties": { "total": { "const": 0 } } },
              "cost": { "type": "object", "properties": { "state": { "const": "zero" } } },
              "token_precision": { "const": null },
              "incomplete_sources": { "type": "array", "maxItems": 0 }
            }
          }
        },
        {
          "if": { "properties": { "state": { "enum": ["missing", "unsupported"] } } },
          "then": {
            "properties": {
              "tokens": { "type": "null" }, "cost": { "type": "null" }, "activity": { "type": "null" },
              "token_precision": { "const": null }
            }
          }
        },
        {
          "if": { "properties": { "state": { "const": "missing" } } },
          "then": {
            "properties": {
              "reason": { "enum": ["repo_not_seen", "window_before_counted_from", "backlog", "source_incomplete"] }
            }
          }
        },
        {
          "if": { "properties": { "state": { "const": "unsupported" } } },
          "then": { "properties": { "reason": { "const": "source_unsupported" } } }
        },
        {
          "if": { "properties": { "state": { "const": "stale" } } },
          "then": { "properties": { "reason": { "const": "ingestion_stale" } } }
        }
      ]
    }
  }
}
