{
  "description": "How a git remote becomes the --repo value (host/owner/repo). The meter and genie both test against these cases. RFC 0018.",
  "cases": [
    { "remote": "https://example.com/acme/widgets.git", "repo": "example.com/acme/widgets" },
    { "remote": "https://EXAMPLE.com/Acme/Widgets", "repo": "example.com/Acme/Widgets" },
    { "remote": "git@example.com:acme/widgets.git", "repo": "example.com/acme/widgets" },
    { "remote": "ssh://git@example.com/acme/widgets.git", "repo": "example.com/acme/widgets" },
    { "remote": "https://someone@example.com/acme/widgets/?ref=x#top", "repo": "example.com/acme/widgets" },
    { "remote": "https://example.org/group/sub/project.git", "repo": "example.org/group/sub/project" },
    { "remote": "file:///srv/git/widgets.git", "repo": null },
    { "remote": "/srv/git/widgets.git", "repo": null },
    { "remote": "../widgets", "repo": null },
    { "remote": "", "repo": null }
  ]
}
