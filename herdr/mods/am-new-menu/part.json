{
  "id": "herdr.am-new-menu",
  "title": "Automagik New Menu",
  "kind": "herdr-mod",
  "paths": [
    "herdr/mods/am-new-menu/**"
  ],
  "provides": [
    "herdr.new-menu@1"
  ],
  "requires": [
    {
      "cap": "herdr.pack",
      "major": 1
    }
  ],
  "os": [
    "macos"
  ],
  "targets": "local",
  "artifact": "automagik-herdr-pack-{version}.tgz",
  "select": "am-new-menu/",
  "entry": {
    "install": [
      "node",
      "../am-sidebar/bin/part.mjs",
      "install",
      "herdr.am-new-menu"
    ],
    "uninstall": [
      "node",
      "../am-sidebar/bin/part.mjs",
      "uninstall",
      "herdr.am-new-menu"
    ],
    "doctor": [
      "node",
      "../am-sidebar/bin/part.mjs",
      "doctor",
      "herdr.am-new-menu"
    ]
  },
  "writes": [],
  "set": [
    "code"
  ]
}
