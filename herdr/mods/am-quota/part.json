{
  "id": "herdr.am-quota",
  "title": "Automagik Accounts",
  "kind": "herdr-mod",
  "paths": [
    "herdr/mods/am-quota/**"
  ],
  "provides": [
    "herdr.quota@1"
  ],
  "requires": [
    {
      "cap": "herdr.pack",
      "major": 1
    }
  ],
  "os": [
    "macos"
  ],
  "targets": "local",
  "artifact": "automagik-herdr-pack-{version}.tgz",
  "select": "am-quota/",
  "entry": {
    "install": [
      "node",
      "../am-sidebar/pack/part.mjs",
      "install",
      "herdr.am-quota"
    ],
    "uninstall": [
      "node",
      "../am-sidebar/pack/part.mjs",
      "uninstall",
      "herdr.am-quota"
    ],
    "doctor": [
      "node",
      "../am-sidebar/pack/part.mjs",
      "doctor",
      "herdr.am-quota"
    ]
  },
  "writes": [],
  "set": [
    "code"
  ]
}
