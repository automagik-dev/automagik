{
  "id": "herdr.am-mods",
  "title": "Automagik Mods (mod manager)",
  "kind": "herdr-mod",
  "paths": [
    "herdr/mods/am-mods/**"
  ],
  "provides": [
    "herdr.mod-manager@1"
  ],
  "requires": [
    {
      "cap": "herdr.pack",
      "major": 1
    }
  ],
  "os": [
    "macos"
  ],
  "targets": "local",
  "artifact": "automagik-herdr-pack-{version}.tgz",
  "select": "am-mods/",
  "entry": {
    "install": [
      "node",
      "../am-sidebar/pack/part.mjs",
      "install",
      "herdr.am-mods"
    ],
    "uninstall": [
      "node",
      "../am-sidebar/pack/part.mjs",
      "uninstall",
      "herdr.am-mods"
    ],
    "doctor": [
      "node",
      "../am-sidebar/pack/part.mjs",
      "doctor",
      "herdr.am-mods"
    ]
  },
  "writes": [
    "$HERDR_APP_HOME/keys.json#global.cmd-shift-m"
  ],
  "set": [
    "code"
  ]
}
