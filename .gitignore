node_modules/
.DS_Store
*.log
.env
.env.*
# Fetched or built, never committed
.cache/
apps/desktop/build/
apps/desktop/dist/
# Fixture runs (apps/bots-dsh/dev/advanced-check.mjs writes .tools/advanced-fixture)
.tools/
# Herdr runtime state; .herdr/bots.json stays visible
.herdr/*.bak-*
.herdr/pane-env*
.herdr/app-home/
.herdr/bots.json.lock
.herdr/bots.json.*.tmp
# Claude Code: only the project skills are tracked. Local settings and the worktrees
# agents work in live under .claude too, and are never committed.
/.claude/*
!/.claude/skills/
