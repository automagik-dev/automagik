{
  "name": "@automagik/acp-dsh",
  "version": "3.138.1",
  "description": "Agents over ACP (Agent Client Protocol) as DeepSeek Harness models: a Session on one streams the agent's words, shows its tool calls as DSH tool cards and asks through DSH's approval dialog",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "acp",
    "agent-client-protocol",
    "agents"
  ],
  "homepage": "https://github.com/automagik-si/automagik/tree/dev/apps/acp-dsh#readme",
  "bugs": {
    "url": "https://github.com/automagik-si/automagik/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/automagik-si/automagik.git",
    "directory": "apps/acp-dsh"
  },
  "license": "Apache-2.0",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "src/host/",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "test": "node --import ./test/harness-resolve.mjs --test \"test/*.test.js\"",
    "lint": "node scripts/lint.mjs",
    "harness": "bun install --cwd dev/harness --no-save --no-summary"
  },
  "engines": {
    "dsh": ">=0.2.2-rc.2 <0.3.0-0",
    "node": ">=24.9"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-session": "*",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/schemastery": "*"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "2.5.0",
    "zod": "4.4.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "automagik": {
    "market": {
      "title": {
        "en": "ACP agents"
      },
      "description": {
        "en": "Agents other than DSH's own as DSH models, over the Agent Client Protocol. A chat on one keeps DSH's history and sidebar; the agent's tool calls show as DSH tool cards and ask through DSH's approval dialog."
      },
      "category": "automagik",
      "keywords": [
        "acp",
        "agent-client-protocol",
        "agents"
      ]
    }
  }
}
