{
  "name": "@automagik/unfold-bot-dsh",
  "version": "3.46.0",
  "description": "Unfold for DeepSeek Harness: the Unfold Bot on the Automagik Bot team, with the Unfold plugins and the Unfold bridge as its defaults",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "unfold",
    "agents"
  ],
  "homepage": "https://github.com/automagik-dev/automagik/tree/dev/apps/unfold-bot-dsh#readme",
  "bugs": {
    "url": "https://github.com/automagik-dev/automagik/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/automagik-dev/automagik.git",
    "directory": "apps/unfold-bot-dsh"
  },
  "license": "Apache-2.0",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "src/host/",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "test": "node --test \"test/*.test.js\"",
    "lint": "node scripts/lint.mjs",
    "harness": "bun install --cwd dev/harness --no-save --no-summary"
  },
  "engines": {
    "dsh": ">=0.2.1-rc.4 <0.2.2-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "automagik": {
    "market": {
      "title": {
        "en": "Unfold"
      },
      "description": {
        "en": "Unfold inside DSH, on the Automagik Bot team. Adds the Unfold Bot, drawn in Unfold's own clay, which follows and carries on the work you do with Unfold through the Unfold plugins and the Unfold bridge. Install it from the welcome's team step, which brings those plugins with it. Part of Unfold; works with the Unfold app."
      },
      "category": "automagik",
      "keywords": [
        "unfold",
        "bot",
        "agents"
      ]
    }
  }
}
