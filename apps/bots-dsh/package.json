{
  "name": "@automagik/bots-dsh",
  "version": "3.138.0",
  "description": "Omni for DeepSeek Harness: a team of long-lived Bots with Omni as the Main Bot; its channels and canvases come with @automagik/omni-channels-dsh and @automagik/omni-canvas-dsh",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "omni",
    "whatsapp",
    "agents"
  ],
  "homepage": "https://github.com/automagik-si/automagik/tree/dev/apps/bots-dsh#readme",
  "bugs": {
    "url": "https://github.com/automagik-si/automagik/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/automagik-si/automagik.git",
    "directory": "apps/bots-dsh"
  },
  "license": "Apache-2.0",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./web-search": "./web-search.js",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "src/host/",
    "src/shared/",
    "src/office/",
    "client.js",
    "office.js",
    "locale/",
    "web-search.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "node scripts/build-client.mjs && node scripts/build-script-child.mjs",
    "test": "node ../../scripts/test-guard.mjs --import ./test/harness-resolve.mjs --test --test-timeout=120000 --test-concurrency=2 \"test/*.test.js\"",
    "lint": "node scripts/lint.mjs",
    "harness": "bun install --cwd dev/harness --no-save --no-summary",
    "check": "sh dev/check.sh",
    "dev:client": "node scripts/watch-client.mjs"
  },
  "dependencies": {
    "ipaddr.js": "2.5.0",
    "playwright-core": "1.64.1",
    "@modelcontextprotocol/client": "2.4.0",
    "deep-view": "0.1.2",
    "imapflow": "2.9.1",
    "jpeg-js": "0.4.4",
    "mailparser": "3.12.4",
    "nodemailer": "10.2.1",
    "pngjs": "7.0.0",
    "ws": "8.18.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-scope": "*",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/dsh-web": "*"
  },
  "dsh": {
    "client": {
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "devDependencies": {
    "@jitl/quickjs-singlefile-mjs-release-sync": "0.32.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "esbuild": "0.28.2",
    "@xmldom/xmldom": "0.9.12",
    "qrcode-generator": "2.0.4",
    "quickjs-emscripten-core": "0.32.0"
  },
  "engines": {
    "dsh": ">=0.2.2-rc.2 <0.3.0-0",
    "node": ">=24.9"
  }
}
