{
  "name": "@automagik/locale-pt-br-dsh",
  "version": "3.86.30",
  "description": "Brazilian Portuguese for DeepSeek Harness 0.2.2 and later. DSH ships Portuguese itself; this pack adds the Bot team's Portuguese (omni-ui) under DSH's own language and keeps a saved pt-BR choice working. Anything it doesn't translate stays in English",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "locale",
    "pt-BR"
  ],
  "homepage": "https://github.com/automagik-dev/automagik/tree/dev/apps/locale-pt-br-dsh#readme",
  "bugs": {
    "url": "https://github.com/automagik-dev/automagik/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/automagik-dev/automagik.git",
    "directory": "apps/locale-pt-br-dsh"
  },
  "license": "Apache-2.0",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "test": "node --test \"test/*.test.js\"",
    "lint": "node scripts/lint.mjs",
    "harness": "bun install --cwd dev/harness --no-save --no-summary"
  },
  "engines": {
    "dsh": ">=0.2.2-rc.1 <0.3.0",
    "node": ">=24.9"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "automagik": {
    "market": {
      "title": {
        "en": "Português (Brasil)"
      },
      "description": {
        "en": "Brazilian Portuguese for DSH 0.2.2 and later. DSH ships Portuguese itself, in Settings › General › Language and across the app; this pack adds the Bot team's own Portuguese under DSH's language. One Portuguese entry, and a pt-BR choice saved before the upgrade keeps working. Requires DeepSeek Harness 0.2.2 or later. Anything it doesn't translate stays in English."
      },
      "category": "automagik",
      "keywords": [
        "locale",
        "language",
        "portuguese",
        "pt-BR"
      ]
    }
  }
}
