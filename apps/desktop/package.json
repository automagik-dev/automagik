{
  "name": "@automagik/omni-desktop",
  "productName": "Automagik",
  "desktopName": "automagik.desktop",
  "version": "3.139.4",
  "private": true,
  "description": "The Automagik desktop app: Automagik's Bot team and Omni's channels on a DeepSeek Harness of its own, with Omni or Genie preloaded",
  "homepage": "https://github.com/automagik-si/automagik/tree/dev/apps/desktop#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/automagik-si/automagik.git",
    "directory": "apps/desktop"
  },
  "author": "Namastex Labs <dev@namastex.ai>",
  "license": "Apache-2.0",
  "type": "module",
  "main": "src/main.js",
  "scripts": {
    "prepare-runtime": "node scripts/prepare-runtime.mjs",
    "start": "electron .",
    "test": "node --test --test-timeout=300000 \"test/*.test.js\"",
    "dist:linux": "node scripts/prepare-runtime.mjs && electron-builder --linux AppImage deb",
    "dist:mac": "node scripts/prepare-runtime.mjs && electron-builder --mac dmg zip",
    "dist:win": "node scripts/prepare-runtime.mjs && electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "44.5.0",
    "electron-builder": "26.16.1"
  },
  "dependencies": {
    "electron-updater": "6.8.10",
    "ws": "8.18.3"
  },
  "bugs": {
    "url": "https://github.com/automagik-si/automagik/issues"
  }
}
