{
  "name": "@automagik/welcome-dsh",
  "version": "3.138.8",
  "description": "Omni's welcome for DeepSeek Harness: the Omni octopus greets you and connects your AI through DSH's own sign-ins",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "omni",
    "onboarding"
  ],
  "homepage": "https://github.com/automagik-si/automagik/tree/dev/apps/welcome-dsh#readme",
  "bugs": {
    "url": "https://github.com/automagik-si/automagik/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/automagik-si/automagik.git",
    "directory": "apps/welcome-dsh"
  },
  "license": "Apache-2.0",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "src/host/",
    "client.js",
    "locale/",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "test": "node --import ./test/harness-resolve.mjs --test \"test/*.test.js\"",
    "lint": "node scripts/lint.mjs",
    "harness": "bun install --cwd dev/harness --no-save --no-summary"
  },
  "engines": {
    "dsh": ">=0.2.2-rc.2 <0.3.0-0",
    "node": ">=24.9"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/schemastery": "*"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "external": [
        "@automagik/bots-dsh/client"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "devDependencies": {
    "@xterm/xterm": "6.0.0",
    "esbuild": "0.28.2"
  },
  "dependencies": {
    "zod": "4.6.5"
  },
  "automagik": {
    "omni": {
      "repository": "https://github.com/automagik-si/omni",
      "version": "2.261112.34",
      "commit": "ead1c99681275a092589fa9635ebe1997d7bcb55"
    },
    "genie": {
      "repository": "https://github.com/automagik-si/genie",
      "path": "plugins/genie-dsh",
      "version": "0.1.4",
      "commit": "39402fb18dd29e33f7c18cb9eb7d5d757c3a7273"
    }
  }
}
